# single inheritance

package placement;
class Animal{
	void eat() {
		System.out.println("eating...");
	}
}
class Dog extends Animal{
	void bark() {
		System.out.println("barking...");
	}
}

public class example_08 {

	public static void main(String[] args) {
		Dog d = new Dog();
		d.bark();
		d.eat();
		// TODO Auto-generated method stub

	}

}
