#check wether the given string is palindrome or not 

package placement;

public class Stringmethod5 {

    public static void main(String[] args) {

        String s = "malayalam";
        String rev = "";

        for(int i = s.length()-1; i >= 0; i--) {
            rev += s.charAt(i);
        }

        if(s.equals(rev))
            System.out.println("Palindrome");
        else
            System.out.println("Not Palindrome");
    }
}
